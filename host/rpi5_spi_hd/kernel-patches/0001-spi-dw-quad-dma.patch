+static int dw_spi_start_quad_rx_frame(struct dw_spi *dws)
+{
+	u32 saved_ser = dw_readl(dws, DW_SPI_SER);
+	unsigned int control_words = dws->enh.ctrl_len;
+
+	/* Both control entries must be present before the first wire clock.
+	 * Native CS can otherwise end an enhanced frame if an IRQ separates
+	 * the instruction and address FIFO writes. RX DMA is already armed.
+	 */
+	if (!saved_ser)
+		return -EOPNOTSUPP; /* Native chip-select required for FIFO prefill */
+	if (!control_words || control_words > dws->fifo_len ||
+	    dw_readl(dws, DW_SPI_TXFLR))
+		return -EINVAL;
+	dw_writel(dws, DW_SPI_SER, 0);
+	dw_spi_start_frame(dws);
+	if (dw_readl(dws, DW_SPI_TXFLR) != control_words) {
+		pr_err("spi-dw: quad RX control prefill not retained: want=%u got=%u\n",
+		       control_words, dw_readl(dws, DW_SPI_TXFLR));
+		/* Drop the incomplete FIFO frame with native CS inactive. */
+		dw_spi_enable_chip(dws, 0);
+		dw_writel(dws, DW_SPI_SER, saved_ser);
+		return -EIO;
+	}
+	dw_writel(dws, DW_SPI_SER, saved_ser);
+	return 0;
+}
+
 static int dw_spi_dma_transfer_all(struct dw_spi *dws,
 				   struct spi_transfer *xfer)
 {
 	int ret;
+	bool quad_dma = xfer->tx_buf && dws->enh.ctrl_len;
 
+	struct scatterlist tx_tail_one;
+	struct scatterlist *tx_tail = NULL;
+	struct scatterlist *tx_sg = xfer->tx_sg.sgl;
+	struct scatterlist *sg;
+	unsigned int tx_nents = xfer->tx_sg.nents;
+	unsigned int tail_nents = 0;
+	unsigned int tail_bytes = 0;
+	unsigned int skip;
+	bool tail_allocated = false;
+	bool ser_gated = false;
+	unsigned int prime_bytes = 0;
+	unsigned int expected_fill = 0;
+	unsigned int i;
+	const u8 *src = xfer->tx_buf;
+	u32 saved_ser = 0;
+
+
+	/* isolated enhanced TX only. Fill
+	 * all available FIFO entries before SCLK and request DMA refill as
+	 * soon as a burst fits. The default low watermark leaves too little
+	 * time at four-line speed, allowing the enhanced frame to end early.
+	 * Use only the mapped tail; reject unsupported layouts.
+	 */
+	if (quad_dma) {
+		if ((dws->n_bytes != 1 && dws->n_bytes != 2 &&
+		     dws->n_bytes != 4) || !tx_nents ||
+		    dws->enh.ctrl_len >= dws->fifo_len ||
+		    !dws->txburst || dws->txburst >= dws->fifo_len) {
+			pr_err("spi-dw: quad DMA prefix rejected: len=%u nents=%u fifo=%u\n",
+			       xfer->len, tx_nents, dws->fifo_len);
+			ret = -EINVAL;
+			goto err_clear_dmac;
+		}
+		/* The SPI core maps before collecting control words. Conservatively
+		 * reserving two control entries can select DMA for a one-control
+		 * frame which also fits in the FIFO. Streaming it is valid.
+		 */
+		/* Always leave at least one complete word for the DMA tail. */
+		if (xfer->len % dws->n_bytes || xfer->len <= dws->n_bytes) {
+			ret = -EINVAL;
+			goto err_clear_dmac;
+		}
+		prime_bytes = min_t(unsigned int,
+					min_t(unsigned int,
+					      dws->fifo_len - dws->enh.ctrl_len,
+					      dws->n_bytes == 4 ? 16 : dws->fifo_len) *
+					      dws->n_bytes,
+					xfer->len - dws->n_bytes);
+		if (!prime_bytes) {
+			ret = -EINVAL;
+			goto err_clear_dmac;
+		}
+		expected_fill = prime_bytes / dws->n_bytes + dws->enh.ctrl_len;
+		dw_writel(dws, DW_SPI_DMATDLR, dws->fifo_len - dws->txburst);
+		/*
+		 * The SPI core may map the TX buffer to any valid SG layout.
+		 * Remove the FIFO-prefilled prefix without assuming one mapped
+		 * DMA segment: preserve the remaining mapped segments and their
+		 * original DMA addresses. No ESP peripheral assumptions here.
+		 */
+		/* Keep the qualified single-SG hot path allocation-free. */
+		if (tx_nents == 1) {
+			tx_tail = &tx_tail_one;
+		} else {
+			tx_tail = kcalloc(tx_nents, sizeof(*tx_tail), GFP_KERNEL);
+			if (!tx_tail) {
+				ret = -ENOMEM;
+				goto err_clear_dmac;
+			}
+			tail_allocated = true;
+		}
+		sg_init_table(tx_tail, tx_nents);
+		skip = prime_bytes;
+		for_each_sg(xfer->tx_sg.sgl, sg, tx_nents, i) {
+			unsigned int nbytes = sg_dma_len(sg);
+
+			if (skip >= nbytes) {
+				skip -= nbytes;
+				continue;
+			}
+			sg_dma_address(&tx_tail[tail_nents]) =
+				sg_dma_address(sg) + skip;
+			sg_dma_len(&tx_tail[tail_nents]) = nbytes - skip;
+			tail_bytes += nbytes - skip;
+			tail_nents++;
+			skip = 0;
+		}
+		if (skip || !tail_nents ||
+		    tail_bytes != xfer->len - prime_bytes) {
+			ret = -EINVAL;
+			goto err_clear_dmac;
+		}
+		/* A DMA engine can require every mapped SG segment to align
+		 * to the configured 8/16/32-bit peripheral data width.
+		 */
+		for (i = 0; i < tail_nents; i++) {
+			if (!IS_ALIGNED(sg_dma_address(&tx_tail[i]), dws->n_bytes) ||
+			    !IS_ALIGNED(sg_dma_len(&tx_tail[i]), dws->n_bytes)) {
+				ret = -EINVAL;
+				goto err_clear_dmac;
+			}
+		}
+		sg_mark_end(&tx_tail[tail_nents - 1]);
+		tx_sg = tx_tail;
+		tx_nents = tail_nents;
+	}
+
 	/* Submit the DMA Tx transfer if required */
 	if (xfer->tx_buf) {
-		ret = dw_spi_dma_submit_tx(dws, xfer->tx_sg.sgl, xfer->tx_sg.nents);
+		ret = dw_spi_dma_submit_tx(dws, tx_sg, tx_nents);
 		if (ret)
 			goto err_clear_dmac;
 	}
@@ -533,20 +691,107 @@
 		dma_async_issue_pending(dws->rxchan);
 	}
 
+	/* native SER prevents any wire clocks
+	 * while the CPU loads control and first payload entries. DMAC is
+	 * submitted for *only the unprimed tail*. Resume SER only after DMA
+	 * is armed, allowing TX FIFO threshold-driven DMA to begin.
+	 */
+	if (quad_dma) {
+		saved_ser = dw_readl(dws, DW_SPI_SER);
+		if (!saved_ser) {
+			/* This prefill mechanism cannot maintain an enhanced
+			 * frame across an unqualified GPIO/externally held CS.
+			 */
+			ret = -EOPNOTSUPP;
+			goto err_clear_dmac;
+		}
+		dw_writel(dws, DW_SPI_SER, 0);
+		ser_gated = true;
+		dw_spi_start_frame(dws);
+		/* SPI core handed this streaming mapping to the DMA device
+		 * before transfer_one. The DMA descriptor is submitted but
+		 * has not been issued: transfer CPU ownership back while
+		 * copying the prefix into the hardware FIFO.
+		 */
+		dma_sync_sgtable_for_cpu(dws->host->cur_tx_dma_dev,
+					 &xfer->tx_sg, DMA_TO_DEVICE);
+		for (i = 0; i < prime_bytes; i += dws->n_bytes) {
+			u32 word = 0;
+			/* Preserve native-endian FIFO order for 8/16/32-bit words. */
+			memcpy(&word, src + i, dws->n_bytes);
+			dw_write_io_reg(dws, DW_SPI_DR, word);
+		}
+		dma_sync_sgtable_for_device(dws->host->cur_tx_dma_dev,
+					    &xfer->tx_sg, DMA_TO_DEVICE);
+		if (dw_readl(dws, DW_SPI_TXFLR) != expected_fill) {
+			pr_err("spi-dw: quad DMA PIO prefill not retained: want=%u got=%u\n",
+			       expected_fill, dw_readl(dws, DW_SPI_TXFLR));
+			ret = -EIO;
+			goto err_clear_dmac;
+		}
+		dws->tx = (u8 *)dws->tx + prime_bytes;
+		dws->tx_len -= prime_bytes / dws->n_bytes;
+	}
 	if (xfer->tx_buf) {
 		dma_async_issue_pending(dws->txchan);
+		if (quad_dma) {
+			dw_writel(dws, DW_SPI_SER, saved_ser);
+			ser_gated = false;
+			dw_writel(dws, DW_SPI_DMACR, DW_SPI_DMACR_TDMAE);
+		}
 	} else {
-		/* Pause to allow DMA channel to fetch RX descriptor */
+
+		/* Use the unchanged upstream DMA descriptor arm interval.
+		 * SG count and word width alone are no hardware-ready signal.
+		 */
 		usleep_range(5, 10);
 
-		/* Write something to the TX FIFO to start the transfer */
-		dw_spi_start_frame(dws);
+		/* Complete enhanced RX controls before allowing wire clocks. */
+		if (xfer->rx_nbits == SPI_NBITS_QUAD && dws->enh.ctrl_len) {
+			ret = dw_spi_start_quad_rx_frame(dws);
+			if (ret)
+				goto err_clear_dmac;
+		} else {
+			dw_spi_start_frame(dws);
+		}
 	}
 
 	ret = dw_spi_dma_wait(dws, xfer->len, xfer->effective_speed_hz);
+	/* The error IRQ also completes the DMA wait object. A wake-up does
+	 * not guarantee that either DMA channel stopped touching the
+	 * temporary tail SG; distinguish normal callbacks from early IRQ.
+	 */
+	if (!ret && dws->host->cur_msg &&
+	    dws->host->cur_msg->status != -EINPROGRESS)
+		ret = dws->host->cur_msg->status ?: -EIO;
+	if (!ret && (test_bit(DW_SPI_TX_BUSY, &dws->dma_chan_busy) ||
+		     test_bit(DW_SPI_RX_BUSY, &dws->dma_chan_busy)))
+		ret = -EIO;
 
 err_clear_dmac:
 	dw_writel(dws, DW_SPI_DMACR, 0);
+	/* Terminate every unfinished DMA channel synchronously before
+	 * freeing the descriptor on error / early controller interrupt.
+	 */
+	if (ret) {
+		if (test_bit(DW_SPI_TX_BUSY, &dws->dma_chan_busy)) {
+			dmaengine_terminate_sync(dws->txchan);
+			clear_bit(DW_SPI_TX_BUSY, &dws->dma_chan_busy);
+		}
+		if (test_bit(DW_SPI_RX_BUSY, &dws->dma_chan_busy)) {
+			dmaengine_terminate_sync(dws->rxchan);
+			clear_bit(DW_SPI_RX_BUSY, &dws->dma_chan_busy);
+		}
+	}
+	if (ser_gated) {
+		/* Never clock out an incomplete FIFO prefix on error. */
+		dw_spi_enable_chip(dws, 0);
+		dw_writel(dws, DW_SPI_SER, saved_ser);
+	}
+	if (quad_dma)
+		dw_writel(dws, DW_SPI_DMATDLR, dws->txburst);
+	if (tail_allocated)
+		kfree(tx_tail);
 
 	return ret;
 }
