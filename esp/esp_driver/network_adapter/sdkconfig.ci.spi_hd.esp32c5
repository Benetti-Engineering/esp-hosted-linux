# Experimental ESP32-C5 SPI-HD/QSPI build-only CI profile.
# Do not enable for other chips without the required Slave-HD v2 capability
# and independent board/controller qualification.
CONFIG_ESP_SPI_HD_HOST_INTERFACE=y
CONFIG_ESP_SPI_HD_MODE=3
CONFIG_ESP_SPI_HD_GPIO_CS=4
CONFIG_ESP_SPI_HD_GPIO_CLK=27
CONFIG_ESP_SPI_HD_GPIO_D0=1
CONFIG_ESP_SPI_HD_GPIO_D1=6
CONFIG_ESP_SPI_HD_GPIO_D2=26
CONFIG_ESP_SPI_HD_GPIO_D3=23
CONFIG_ESP_SPI_HD_GPIO_DATA_READY=2
CONFIG_ESP_SPI_HD_RX_SEGMENT_SIZE=3200
CONFIG_ESP_SPI_HD_RX_Q_SIZE=4
CONFIG_ESP_SPI_HD_DMA_APPEND=y
CONFIG_ESP_SPI_HD_TX_BATCH=y
CONFIG_ESP_SPI_HD_TX_LEN_MIRROR=y
CONFIG_ESP_SPI_HD_TX_POOL_SIZE=4
CONFIG_ESP_SPI_HD_MAX_CLK_MHZ=40
CONFIG_ESP_SPI_HD_CHECKSUM=y
